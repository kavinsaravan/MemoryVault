# Trusted LangGraph application runner only. Never load the combined .env.local.
ANTHROPIC_API_KEY=replace-with-your-provider-key
MEMORYVAULT_MODEL=replace-with-a-tool-capable-Claude-model-id
MEMORYVAULT_USER_EMAIL=owner@example.com
MEMORYVAULT_BROKER_URL=http://127.0.0.1:8788
MEMORYVAULT_AGENT_TOKEN=replace-with-random-token-at-least-32-characters
MEMORYVAULT_HOOK_TOKEN=replace-with-different-random-token-at-least-32-characters
