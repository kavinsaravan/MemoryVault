# Set these in the shell that launches Claude Code and the dashboard.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
MEMORYVAULT_USER_ID=replace-with-auth-user-uuid
MEMORYVAULT_USER_EMAIL=user@company.example
MEMORYVAULT_MODE=protected
