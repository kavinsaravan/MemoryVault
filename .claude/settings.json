{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Write(~/.claude/projects/**/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "MultiEdit(~/.claude/projects/**/memory/**)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--env-file=.env.local",
              "--import",
              "tsx",
              "src/hook.ts"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--env-file=.env.local",
              "--import",
              "tsx",
              "src/hook.ts"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|WebFetch|WebSearch|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--env-file=.env.local",
              "--import",
              "tsx",
              "src/hook.ts"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|mcp__memoryvault__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--env-file=.env.local",
              "--import",
              "tsx",
              "src/hook.ts"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
